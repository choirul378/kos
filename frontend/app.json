{
  "expo": {
    "name": "DSKos",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.kamarkosoffline.m5xn7g",
      "infoPlist": {
        "NSCameraUsageDescription": "Foto KTP penghuni langsung dari kamera",
        "NSPhotoLibraryUsageDescription": "Pilih foto KTP penghuni dari galeri",
        "NSFaceIDUsageDescription": "Buka aplikasi kos dengan aman"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-bg.png",
        "backgroundColor": "#0A8C98"
      },
      "package": "com.emergent.kamarkosoffline.m5xn7g",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A8C98"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto KTP penghuni dari galeri",
          "cameraPermission": "Foto KTP penghuni langsung dari kamera"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Buka aplikasi kos dengan aman"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "466b18f6-98eb-4266-9f01-c7ce7789b0d4"
      }
    },
    "owner": "choirul378s-team"
  }
}
